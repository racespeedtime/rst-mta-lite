# =============================================================================
# rst-mta-lite
# 原则：仓库只保存「源代码 / 文档 / 配置模板」。
#       二进制、第三方运行时、构建产物、运行时状态、密钥一律不入库。
# =============================================================================

# -----------------------------------------------------------------------------
# 1) MTA:SA 服务端本地安装
#    server/ 整个目录忽略，只显式放行项目自有资源源码：
#    server/mods/deathmatch/resources/[rst]/
#    注意：[ ] 在 gitignore 里是通配符，必须写成 \[ \]
# -----------------------------------------------------------------------------
/server/*
!/server/mods/
/server/mods/*
!/server/mods/deathmatch/
/server/mods/deathmatch/*
!/server/mods/deathmatch/resources/
/server/mods/deathmatch/resources/*
!/server/mods/deathmatch/resources/\[rst\]/

# -----------------------------------------------------------------------------
# 2) 客户端 CEF UI：源码在 cef/（入库），构建产物输出到 rst_ui/ui/（见第 5 节）
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# 3) MTA 运行时状态（出现在任何一层都不入库）
#    含服务器标识、崩溃信息、玩家数据与 ACL 凭据，不能提交
# -----------------------------------------------------------------------------
**/dumps/
**/logs/
**/resource-cache/
**/backups/
**/databases/
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm
**/server-id.keys
**/acl.xml
**/editor_acl.xml
**/mtaserver.conf

# -----------------------------------------------------------------------------
# 4) 可执行文件 / 二进制库 / 归档包
# -----------------------------------------------------------------------------
*.exe
*.dll
*.pdb
*.dmp
*.so
*.dylib
*.lib
*.obj
*.o
*.msi
*.zip
*.7z
*.rar
*.tar
*.gz

# -----------------------------------------------------------------------------
# 5) 前端（Vue / Vite / pnpm）依赖与构建产物
# -----------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
coverage/
.vite/
*.timestamp-*.mjs
*.tsbuildinfo
.eslintcache
.oxlintcache

# CEF UI：Vue 构建产物同步到资源内，构建生成、不入库
server/mods/deathmatch/resources/\[rst\]/rst_ui/ui/

# -----------------------------------------------------------------------------
# 6) 环境变量与密钥
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# -----------------------------------------------------------------------------
# 7) 日志、临时文件、系统与编辑器
# -----------------------------------------------------------------------------
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
.history/

# -----------------------------------------------------------------------------
# 8) AI / 本地工具目录
# -----------------------------------------------------------------------------
.agents/
.claude/
.cursor/
