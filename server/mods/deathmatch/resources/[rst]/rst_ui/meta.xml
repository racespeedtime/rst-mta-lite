<meta>
    <info
        author="rst"
        name="rst_ui"
        version="0.2.0"
        type="script"
        description="rst-mta-lite：CEF + Vue 登录 / 舞台选择 / DeathMatch 房间 / 投票 / rewind"
    />

    <!-- 服务端 -->
    <script src="shared/config.lua" type="server" />
    <script src="server/accounts.lua" type="server" />
    <script src="server/mapstats.lua" type="server" />
    <script src="server/mapregistry.lua" type="server" />
    <script src="server/mapmanager.lua" type="server" />
    <script src="server/rooms.lua" type="server" />
    <script src="server/main.lua" type="server" />

    <!-- 客户端 -->
    <script src="client/main.lua" type="client" />
    <script src="client/rewind.lua" type="client" />

    <!-- UI 音效 -->
    <file src="sounds/click.wav" />
    <file src="sounds/confirm.wav" />

    <!-- Vue 构建产物（cef/vite.config.ts 输出到这里，ui/ 不入库） -->
    <file src="ui/index.html" />
    <file src="ui/assets/app.js" />
    <file src="ui/assets/style.css" />

    <min_mta_version client="1.6.0" server="1.6.0" />

    <!-- 需要管理员批准：允许读取/切换 mtavault 地图资源 -->
    <aclrequest>
        <right name="function.startResource" access="true" />
        <right name="function.stopResource" access="true" />
        <right name="function.xmlLoadFile" access="true" />
    </aclrequest>
</meta>
