<meta>
    <info
        author="rst"
        name="rst_ui"
        version="0.2.0"
        type="script"
        description="rst-mta-lite：CEF + Vue 登录 / 舞台选择 / DeathMatch 房间 / 投票 / 倒带"
    />

    <!-- 服务端 -->
    <script src="shared/config.lua" type="server" />
    <script src="server/accounts.lua" type="server" />
    <script src="server/mapstats.lua" type="server" />
    <script src="server/records.lua" type="server" />
    <script src="server/mapmeta.lua" type="server" />
    <script src="server/mapstore.lua" type="server" />
    <script src="server/mapregistry.lua" type="server" />
    <script src="server/mapmanager.lua" type="server" />
    <script src="server/rooms.lua" type="server" />
    <script src="server/main.lua" type="server" />

    <!-- 客户端 -->
    <script src="client/main.lua" type="client" />
    <script src="client/rewind.lua" type="client" />
    <script src="client/warp.lua" type="client" />
    <script src="client/pickups.lua" type="client" />
    <script src="client/custommodels.lua" type="client" />

    <!-- 可选服务器默认 Infernus 模型；没有文件时不会生效 -->
    <file src="models/*.dff" />
    <file src="models/*.txd" />

    <!-- 地图外部展示元数据：按地图 resource 的 sidecar，按需读取；不集中索引 -->
    <file src="covers/silent-hill.jpg" />
    <file src="covers/a-new-dawn.jpg" />
    <file src="covers/descendants-skills-v.jpg" />

    <!-- UI 音效 -->
    <file src="sounds/click.wav" />
    <file src="sounds/confirm.wav" />
    <file src="sounds/countdown.wav" />
    <file src="sounds/go.wav" />
    <file src="sounds/finish.wav" />
    <file src="sounds/fail.wav" />

    <!-- racepickup 模型（官方 race 资源同款） -->
    <file src="pickups/nitro.dff" />
    <file src="pickups/nitro.txd" />
    <file src="pickups/repair.dff" />
    <file src="pickups/repair.txd" />
    <file src="pickups/vehiclechange.dff" />
    <file src="pickups/vehiclechange.txd" />

    <!-- Vue 构建产物（cef/vite.config.ts 输出到这里，ui/ 不入库） -->
    <file src="ui/index.html" />
    <file src="ui/assets/app.js" />
    <file src="ui/assets/style.css" />

    <min_mta_version client="1.6.0" server="1.6.0" />

    <!-- 核心 UI / 模型 fallback 先于地图资源启动，地图模型随后覆盖 -->
    <download_priority_group>100</download_priority_group>

    <!-- 需要管理员批准：按需装载地图库 / 切换地图资源 -->
    <aclrequest>
        <right name="function.startResource" access="true" />
        <right name="function.stopResource" access="true" />
        <right name="function.restartResource" access="true" />
        <right name="function.createResource" access="true" />
        <right name="function.deleteResource" access="true" />
        <right name="function.refreshResources" access="true" />
        <right name="function.xmlLoadFile" access="true" />
    </aclrequest>
</meta>
